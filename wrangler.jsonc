{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bikkura-review",
  "compatibility_date": "2026-08-22",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bikkura-review-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
